# Proxy Sentinel 环境变量示例（复制为 .env 并修改）
# 端口
SERVER_PORT=8080

# 后端目标（逗号分隔多个，用于负载均衡）
BACKEND_URLS=http://127.0.0.1:9001

# 负载均衡策略：round_robin | random
BALANCER_STRATEGY=round_robin

# 数据库
DATABASE_PATH=./data/sentinel.db

# 代理超时与请求体大小
PROXY_TIMEOUT_SECONDS=30
PROXY_MAX_BODY_BYTES=10485760

# 可视化页面管理员（首次启动自动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# JWT 签名密钥（务必修改为随机串）
JWT_SECRET=change-this-to-a-random-secret

# 代理接口 Bearer Token 列表（逗号分隔）
PROXY_TOKENS=dev-proxy-token-please-change

# 日志
LOG_LEVEL=info
LOG_SAMPLE_RATE=1.0
LOG_RETENTION_DAYS=30
LOG_MASK_SENSITIVE=true

# 生产环境启用 Secure Cookie（需 HTTPS）
SECURE_COOKIE=false
